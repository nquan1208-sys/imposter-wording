# Copy this file to the mode-specific local file you need.
# These values are injected into the browser by Vite.
# Never put a Supabase service_role or secret key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# File mapping:
# - .env.local                  -> local Supabase stack (vite --mode localdev)
# - .env.development.local      -> shared dev Supabase project (vite --mode development)
# - .env.production.local       -> production Supabase project (vite --mode production)
