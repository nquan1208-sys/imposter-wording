{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Local",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "local"
      ]
    },
    {
      "name": "Flutter Dev",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "dev"
      ]
    },
    {
      "name": "Flutter Prod",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "prod"
      ]
    }
  ]
}
